{
  "name": "predator-call-player",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start --clear --tunnel",
    "dev-local": "EXPO_NO_TELEMETRY=1 expo start --clear --localhost",
    "dev-lan": "EXPO_NO_TELEMETRY=1 expo start --clear --lan",
    "lint": "expo lint",
    "build:ios": "eas build --platform ios --profile preview",
    "build:android": "eas build --platform android --profile preview",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/orbitron": "^0.2.3",
    "@expo-google-fonts/roboto": "^0.2.3",
    "@expo-google-fonts/roboto-slab": "^0.2.3",
    "@expo/vector-icons": "^14.0.4",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/slider": "^4.5.7",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.15",
    "@supabase/supabase-js": "^2.39.8",
    "expo": "~52.0.0",
    "expo-av": "~15.0.1",
    "expo-blur": "~14.0.1",
    "expo-build-properties": "~0.14.1",
    "expo-constants": "~17.0.3",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~18.0.4",
    "expo-font": "~13.0.1",
    "expo-haptics": "~14.0.0",
    "expo-linear-gradient": "~14.0.1",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.9",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-symbols": "~0.2.0",
    "expo-system-ui": "~4.0.4",
    "expo-web-browser": "~14.0.1",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-svg": "15.8.0",
    "react-native-system-setting": "^1.7.6",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "eas-cli": "^7.5.0",
    "typescript": "^5.3.3"
  }
}